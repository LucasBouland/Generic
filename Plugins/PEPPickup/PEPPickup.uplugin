    {
      "Name": "PEPPickup",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "PEPPickupEditor",
      "Type": "Editor",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    {
      "Name": "PEPCore",
      "Enabled": true
    },
    {
      "Name": "PEPItems",
      "Enabled": true
    },
    {
      "Name": "PEPInventory",
      "Enabled": true
    },
    {
      "Name": "PEPInteraction",
      "Enabled": true
    }
  ]
}
